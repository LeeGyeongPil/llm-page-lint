# Only needed for `llm-page-lint refine --judge openai --fixer openai` (experimental).
# Without these, refine runs with the practice mock judge and fixer.
LLM_PAGE_LINT_BASE_URL=http://localhost:11434/v1
LLM_PAGE_LINT_API_KEY=
LLM_PAGE_LINT_JUDGE_MODEL=
LLM_PAGE_LINT_FIXER_MODEL=
# Optional: where Chromium is installed (default: Playwright's user cache, outside the repo).
# On Linux Playwright looks in $XDG_CACHE_HOME/ms-playwright, so if you change XDG_CACHE_HOME only to move
# the reports, also set this to where Chromium was installed (usually ~/.cache/ms-playwright) — or use --out.
# PLAYWRIGHT_BROWSERS_PATH=
