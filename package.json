{
  "name": "llm-page-lint",
  "version": "0.1.0",
  "description": "Reference-free visual defect linter for LLM-generated HTML pages (overlapping, clipped, off-screen text, low contrast over images, ...).",
  "license": "MIT",
  "author": "LeeGyeongPil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeeGyeongPil/llm-page-lint.git"
  },
  "keywords": [
    "lint",
    "visual",
    "html",
    "playwright",
    "llm",
    "contrast",
    "layout",
    "ci"
  ],
  "type": "module",
  "bin": {
    "llm-page-lint": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/",
    "start": "npm run build --silent && node dist/cli.js demo",
    "compare:axe": "npm run build --silent && node scripts/compare-axe.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "parse5": "8.1.1",
    "playwright": "1.65.0",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "axe-core": "4.14.0",
    "typescript": "7.0.2"
  }
}
